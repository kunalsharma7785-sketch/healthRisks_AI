# Environment configuration
ENVIRONMENT=development
PROJECT_NAME="HealthRisk AI"
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-in-production

# Database (PostgreSQL for docker-compose, SQLite for quick local test)
DATABASE_URL=postgresql://healthrisk_user:healthrisk_pass@postgres:5432/healthrisk_db
# Local SQLite fallback:
# DATABASE_URL=sqlite:///./healthrisk.db

# Redis
REDIS_URL=redis://redis:6379/0

# Rate limits
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_PREDICT_MAX=30
RATE_LIMIT_DIARY_MAX=60
LOCKOUT_DURATION_SEC=900

# ML Model storage
MODEL_DIR=./ml_models
